# nats-server.conf

server_name: $BOTNATS_NATS_SERVER_NAME
host: "::"
port: 4222
http: "[::]:8222"

# JetStream backs the atomic single-use TOTP claim (KV bucket).
# The bucket uses file storage so a claimed counter survives node and
# full-cluster restarts; store_dir lives on the mounted /data volume.
jetstream {
  store_dir: "/data/jetstream"
  max_memory_store: 67108864
  max_file_store: 268435456
}

authorization {
  token: $BOTNATS_NATS_TOKEN
}

cluster {
  name: flynet
  host: "::"
  port: 6222
  advertise: $BOTNATS_NATS_CLUSTER_ADVERTISE
  no_advertise: true

  authorization {
    user: flynet
    password: $BOTNATS_NATS_TOKEN
  }

  routes: [
{% for route in nats_routes %}
    {{ route }}{{ ',' if not loop.last else '' }}
{% endfor %}
  ]
}
