# nats-server.conf

server_name: $NATS_SERVER_NAME
host: "::"
port: 4222
http: "[::]:8222"

# JetStream backs the atomic single-use TOTP claim (KV bucket).
# The bucket uses file storage so a claimed counter survives node and
# full-cluster restarts; store_dir lives on the mounted /data volume.
jetstream {
  store_dir: "/data"
  max_memory_store: 67108864
  max_file_store: 268435456
}

authorization {
  token: $NATS_TOKEN
}

cluster {
  name: flynet
  host: "::"
  port: 6222
  advertise: $NATS_CLUSTER_ADVERTISE
  no_advertise: true

  authorization {
    user: flynet
    password: $NATS_CLUSTER_TOKEN
  }

  routes: [
    $NATS_ROUTE_FRA,
    $NATS_ROUTE_IAD,
    $NATS_ROUTE_ORD
  ]
}
